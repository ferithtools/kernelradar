[Unit]
Description=kernelradar - behavioral anomaly detection for the Linux kernel
Documentation=https://github.com/ferithtools/kernelradar
After=network.target
ConditionKernelVersion=>=6.1

[Service]
Type=simple
ExecStart=/usr/local/bin/kernelradar daemon \
    --bpf-dir /var/lib/kernelradar/bpf \
    --format=journald
Environment=RUST_LOG=kernelradar=info,kernelradar.alert=info,kernelradar.summary=info
Restart=on-failure
RestartSec=5

# stdout/stderr → journald with t=kernelradar
SyslogIdentifier=kernelradar
StandardOutput=journal
StandardError=journal

# Capabilities: BPF + tracepoints. We don't need full root for BPF
# on kernel 5.8+, but some helpers (bpf_probe_read_user) require
# CAP_SYS_ADMIN. Keep it minimal but sufficient.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_ADMIN
NoNewPrivileges=false

# Filesystem hardening: read-only except journald + own state.
# BPF objects under /var/lib/kernelradar/bpf are bind-mounted
# read-only inside the unit's namespace - even if an attacker with
# local root writes to /var/lib/kernelradar/bpf on the real FS, the
# daemon process itself sees the directory as read-only and refuses
# to write. baseline.json and other dynamic state live in
# /var/lib/kernelradar/state, which is the only writable path.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kernelradar/state /run/kernelradar
BindReadOnlyPaths=/var/lib/kernelradar/bpf
StateDirectory=kernelradar
RuntimeDirectory=kernelradar

# Process hardening
# ProtectKernelTunables / ProtectKernelModules are FALSE because we
# load BPF programs (which is "loading kernel code") and may need to
# touch /proc/sys/kernel/* for runtime tuning.
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# BPF JIT generates executable code, so we cannot deny W^X.
MemoryDenyWriteExecute=false

# Network: AF_INET[6] required for the optional Prometheus endpoint
# and webhook output. Drop them in pure-journald deployments by
# changing this line to "AF_UNIX AF_NETLINK".
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

# Resource limits - keep small, BPF programs are tiny
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
